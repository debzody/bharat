// ── Firestore Security Rules ────────────────────────────────────
// Paste these into Firebase Console → Firestore Database → Rules tab,
// then click "Publish".
//
// What they enforce:
//   • Anyone (signed in or not) can READ packages.
//   • Only the admin (signed in with ADMIN_EMAIL) can WRITE packages.
//   • Each user can read & write only their own profile (users/{uid}).
//   • Each user can read & write only their own bookings (bookings/{id} where userId == uid).
//   • The "usernames" map (for username → email lookup at login) is
//     readable by anyone, but each entry can only be written by the
//     user who owns the matching uid.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "deb@andamanvoyages.in",
          "admin@admin.com"
        ];
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Public packages collection
    match /packages/{pkgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public gallery collection — image metadata (URLs in Storage).
    // Anyone can read; only admins can write.
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site-wide settings (e.g. payments toggle, maintenance mode).
    // Public read so all visitors get the live value; admin-only write.
    match /settings/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles — each user owns their doc (doc id = auth uid).
    // Admins additionally have unrestricted access so they can run the
    // /migrate mirror tool, manage customers from the dashboard, etc.
    match /users/{uid} {
      allow read:   if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) || isAdmin();
      allow update, delete: if isSelf(uid) || isAdmin();
    }

    // Username → uid/email lookup (used for "login by username" flow)
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth != null
        && request.resource.data.uid == request.auth.uid);
      // Admin can also clean up usernames when deleting users
      allow update, delete: if isAdmin() || (
        request.auth != null
        && resource.data.uid == request.auth.uid
      );
    }

    // Bookings — each booking has a userId field. Admins have full access
    // so they can mirror, refund, cancel and inspect bookings from the
    // dashboard / migrate tool.
    match /bookings/{bookingId} {
      allow read:   if request.auth != null
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (request.auth != null
        && request.resource.data.userId == request.auth.uid);
      allow update, delete: if request.auth != null
        && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Mail collection — used by the Firebase "Trigger Email" extension.
    // Authenticated users can create their own mail docs (e.g. custom-trip
    // enquiries from /customize). Reads are admin-only so users can't see
    // what other users sent. Updates/deletes are admin-only too.
    match /mail/{mailId} {
      allow create: if request.auth != null
        && request.resource.data.message != null;
      allow read, update, delete: if isAdmin();
    }

    // Custom-trip enquiries (audit log for the admin dashboard).
    // Logged-in users can create one tied to their uid; only admins
    // (and the owning user) can read; only admins can update/delete.
    match /customEnquiries/{ref} {
      allow create: if request.auth != null
        && (request.resource.data.user == null
            || request.resource.data.user.uid == request.auth.uid
            || isAdmin());
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.user != null
            && resource.data.user.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}